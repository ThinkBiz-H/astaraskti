# ==================== JWT AUTH ====================
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRE=30d
# How long the refresh-token cookie itself is valid, in days (defaults to 30 if unset)
COOKIE_EXPIRE_DAYS=30
# Legacy/alternate JWT secret referenced in a couple of older code paths — safe to set the same as JWT_ACCESS_SECRET
JWT_SECRET=replace_with_a_long_random_string

# Password hashing cost (bcrypt). Defaults to 10 if unset.
BCRYPT_SALT_ROUNDS=10

# Account lockout after repeated failed logins (email/password flow).
# NOTE: as of this codebase, these two are read but not actually enforced in
# controllers/auth.controller.js's login function yet — see API_DOCUMENTATION.md
# "Missing APIs" for details. Safe to set now for when that gets wired up.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ==================== OTP (mobile login / verification) ====================
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

