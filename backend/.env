# DEV ONLY — set true to bypass Razorpay entirely for Premium Kundli orders
# (no order created, no checkout opened, no signature verification) and go
# straight to AstrologyAPI/PDF/email generation. Ignored outside development
# — see premiumKundli.controller.js's createOrder (it also checks NODE_ENV).
SKIP_KUNDLI_PAYMENT=false

# ==================== ASTROLOGYAPI.COM (Premium Kundli generation) ====================
# Get these from your astrologyapi.com dashboard — auth is HTTP Basic with
# user_id + api_key (NOT a single bearer token). Until both are set,
# services/kundliGeneration.service.js marks new paid orders "Failed" with
# a clear generationError message rather than silently doing nothing.
ASTROLOGY_API_USER_ID=your_astrologyapi_user_id
ASTROLOGY_API_KEY=your_astrologyapi_api_key
ASTROLOGY_API_BASE_URL=https://json.astrologyapi.com/v1
# Which report product to call — depends on your specific plan; /planets
# (basic planetary positions) works on every plan as a safe default.
ASTROLOGY_API_KUNDLI_ENDPOINT=/planets
# Official ready-made Premium Kundli PDF report product — served from a
# DIFFERENT host than the plain-JSON endpoints above, same credentials.
# kundliGeneration.service.js tries this first, falling back to the
# /planets + self-rendered-PDF path above if it's unavailable.
ASTROLOGY_PDF_BASE_URL=https://pdf.astrologyapi.com/v1
ASTROLOGY_PDF_KUNDLI_ENDPOINT=/premium_kundli_report
# Chart layout style sent to the Premium Kundli PDF endpoint — optional,
# defaults to north-indian if unset.
ASTROLOGY_PDF_CHART_STYLE=north-indian

# Premium Horoscope module (services/horoscope.service.js) — a DIFFERENT
# auth scheme (x-astrologyapi-key header, not Basic auth) and a GENERIC
# sun-sign prediction, not a personalized birth-chart report. The zodiac
# sign is computed from DOB and appended automatically — change the period
# segment here (daily/weekly/monthly) to switch what's reported on.
HOROSCOPE_API_ENDPOINT=/sun_sign_prediction/daily

# DEV ONLY — Premium Horoscope's own payment bypass, independent of
# SKIP_KUNDLI_PAYMENT above (see horoscope.controller.js's devGenerateHoroscope).
TEST_MODE=false

# ==================== SHIPROCKET (shipping — optional) ====================
# Leave SHIPROCKET_ENABLED=false to fall back to manual/standard shipping;
# order creation and tracking work fine either way.
SHIPROCKET_ENABLED=false
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=your_shiprocket_account_email
SHIPROCKET_PASSWORD=your_shiprocket_account_password
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=110001
# Shared-secret header Shiprocket sends back on its webhook — set the same value in the Shiprocket dashboard
SHIPROCKET_WEBHOOK_TOKEN=choose_a_shared_secret_string

# ==================== SMTP (transactional email) ====================
SMTP_HOST=mail.rovexaloan.com
SMTP_PORT=465
SMTP_USER=no-reply@norvexloan.com
SMTP_PASS=Admin@121
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=Astro Sanatan Shakti
MAIL_DRIVER=smtp

MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
# ==================== SMS / PUSH PROVIDERS ====================
# Both are read as an abstraction switch (services/sms.service.js,
# services/push.service.js), but as shipped, NEITHER has a real provider
# case implemented — only a console-log fallback when left unset, and a
# thrown "not implemented" error if you set them to anything. Leave blank
# unless you've added a real provider branch (e.g. Twilio/MSG91 for SMS,
# Firebase for push) to the corresponding service file yourself.
SMS_PROVIDER=
PUSH_PROVIDER=
# Only read from a commented-out Firebase code path in push.service.js —
# currently has no effect either way. Uncomment that block and set this if
# you wire up real Firebase push.
FIREBASE_SERVICE_ACCOUNT=

# ==================== REDIS (optional response cache) ====================
# App runs fine with this unset — cache middleware just no-ops.
REDIS_URL=redis://127.0.0.1:6379

